{
  "name": "core-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts api",
    "build": "prisma generate && tsc -b",
    "start": "node dist/index.js api",
    "start:analytics": "node dist/index.js analytics-worker",
    "test": "vitest run --no-file-parallelism src",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@mywebdrive/observability": "workspace:*",
    "@prisma/client": "^5.19.1",
    "express": "^4.19.2",
    "ioredis": "^5.7.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/supertest": "^7.2.1",
    "prisma": "^5.19.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  }
}
