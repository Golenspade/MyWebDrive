{
  "name": "user-service-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b --force && prisma generate",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "test:legacy": "vitest run src"
  },
  "dependencies": {
    "@mywebdrive/common": "workspace:*",
    "@mywebdrive/observability": "workspace:*",
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.10",
    "@types/supertest": "^7.2.1",
    "prisma": "^5.19.1",
    "rimraf": "^5.0.5",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  }
}
