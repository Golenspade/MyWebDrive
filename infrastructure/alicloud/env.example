# Production Core topology. See ../../docs/env.example for explanations.
REGISTRY=
IMAGE_TAG=
GIT_SHA=
DEPLOY_STATE_DIR=

POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=mywebdrive
