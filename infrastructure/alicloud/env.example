# Production Core topology. See ../../docs/env.example for explanations.
REGISTRY=ghcr.io/golenspade
IMAGE_TAG=
# GIT_SHA is derived and exported by deploy.sh from IMAGE_TAG.
DEPLOY_STATE_DIR=

POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=mywebdrive
CORE_DATABASE_URL=postgresql://mywebdrive:<url-encoded-postgres-password>@postgres:5432/mywebdrive_core?schema=public
REDIS_URL=redis://:<url-encoded-redis-password>@redis:6379/0

CORE_SESSION_SECRET=
OTP_PEPPER=
STORAGE_GRANT_SECRET=
CORE_CALLBACK_SECRET=
DEFAULT_USER_QUOTA_BYTES=10737418240
CORE_ADMIN_EMAILS=
PROMETHEUS_URL=http://prometheus:9090
# Shared only by Core and the private email-provider container. Generate at
# least 32 random bytes; EMAIL_PROVIDER_URL is fixed by the Compose contract.
EMAIL_PROVIDER_TOKEN=
HTTP_PORT=80

# Optional exact digest used only by rollback manifests.
# EMAIL_PROVIDER_IMAGE=registry.example/mywebdrive-email-provider@sha256:...
# PROMETHEUS_IMAGE=registry.example/mywebdrive-prometheus@sha256:...
