# Monorepo ignores
node_modules/
**/node_modules/

# Environment files
.env
.env.*
!.env.example
!docs/env.example

# Logs
logs/
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs / caches
**/*.tsbuildinfo
.ruff_cache/
.pnpm-store/
**/dist/

# Framework outputs
**/.next/
**/out/
playwright-report/
test-results/

# Prisma generated clients and dev DBs
services/*/prisma/client/
services/*/prisma/generated/
**/.prisma/client/
**/generated/prisma/
**/prisma/**/*query_engine*
**/prisma/**/*schema-engine*
**/prisma/**/*migration-engine*
services/*/prisma/*.db
services/*/prisma/services/
services/data/

# Runtime process metadata and non-pnpm frontend locks
**/*.pid
frontend/**/package-lock.json

# Coverage
coverage/
.nyc_output/

# OS / editors
.DS_Store
.idea/
.claude/
.vscode/
.tmp_*.mjs




# Runtime storage payloads (do not track)
services/storage/storage/
data/*.db
*.sqlite
*.sqlite3
demo-screenshots/
archive/local-runtime-*/

# Large local assets (not tracked)
assetsReal/

# Deployment artifacts (large tar files)
deploy/

# Internal augmentation artifacts (ignore if re-created)
.augment_*.txt
*.augment.log

# Local ops secrets (do not commit)
.ops/
.state/
*.pem
*.key
frontend/_templates/tailwind-landing-page-template

# Local MCP / agent tooling
.chunkhound.json
.chunkhound/
.serena/
opencode.json
