{
  "name": "mywebdrive",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm run build:all",
    "build:all": "pnpm --filter './packages/common' --filter './packages/observability' --filter './services/core-api' --filter './services/email-provider' --filter './services/storage' --filter './frontend/cruip-landing' run build",
    "test:all": "pnpm --if-present --filter './packages/common' --filter './packages/observability' --filter './services/core-api' --filter './services/email-provider' --filter './services/storage' --filter './frontend/cruip-landing' run test && pnpm run test:generated && pnpm run verify:generated",
    "test:legacy": "bash scripts/run-legacy-tests.sh",
    "test:generated": "bash scripts/test-generated-artifacts-contract.sh",
    "verify:generated": "bash scripts/verify-no-generated-artifacts.sh",
    "lint:all": "pnpm --if-present --filter './packages/common' --filter './packages/observability' --filter './services/core-api' --filter './services/email-provider' --filter './services/storage' --filter './frontend/cruip-landing' run lint",
    "typecheck": "pnpm --filter './packages/common' --filter './packages/observability' --filter './services/core-api' --filter './services/email-provider' --filter './services/storage' --filter './frontend/cruip-landing' exec tsc -b --pretty false",
    "clean": "pnpm --if-present --filter './packages/common' --filter './packages/observability' --filter './services/core-api' --filter './services/email-provider' --filter './services/storage' --filter './frontend/cruip-landing' run clean",
    "dev": "pnpm -C frontend/cruip-landing dev"
  },
  "devDependencies": {
    "eslint-plugin-react-refresh": "^0.4.24",
    "typescript": "5.9.3"
  }
}
