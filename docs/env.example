# MyWebDrive Core production environment contract
# Copy to a deployment-only .env file. Never commit populated values.

# Immutable release identity. IMAGE_TAG must be a git SHA tag; deploy.sh records
# the five resolved application image digests under DEPLOY_STATE_DIR.
REGISTRY=ghcr.io/golenspade
IMAGE_TAG=
GIT_SHA=
DEPLOY_STATE_DIR=

# Raw infrastructure credentials. Generate unique values; there are no defaults.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=mywebdrive

# URLs must contain URL-encoded credentials. POSTGRES_PASSWORD and REDIS_PASSWORD
# above are raw values used by the containers; percent-encode them separately for
# CORE_DATABASE_URL and REDIS_URL (for example, @ becomes %40 and : becomes %3A).
CORE_DATABASE_URL=postgresql://mywebdrive:<url-encoded-postgres-password>@postgres:5432/mywebdrive_core?schema=public
REDIS_URL=redis://:<url-encoded-redis-password>@redis:6379/0

# Generate four distinct values with at least 32 UTF-8 bytes each. Do not reuse
# database, Redis, email or object-store credentials.
CORE_SESSION_SECRET=
OTP_PEPPER=
STORAGE_GRANT_SECRET=
CORE_CALLBACK_SECRET=

# Core account/bootstrap policy.
DEFAULT_USER_QUOTA_BYTES=10737418240
CORE_ADMIN_EMAILS=

# Core calls the non-public email-provider service at the fixed Compose origin
# http://email-provider:8090. Generate a distinct token of at least 32 bytes.
EMAIL_PROVIDER_TOKEN=

# Public listener. TLS may terminate in a trusted outer load balancer; Nginx is
# still the only application-layer public router.
HTTP_PORT=80

# Optional exact digest references used by digest rollback manifests. Normal
# builds set only REGISTRY + IMAGE_TAG; deploy.sh records these five values.
# CORE_API_IMAGE=registry.example/mywebdrive-core-api@sha256:...
# EMAIL_PROVIDER_IMAGE=registry.example/mywebdrive-email-provider@sha256:...
# STORAGE_IMAGE=registry.example/mywebdrive-storage@sha256:...
# WEB_IMAGE=registry.example/mywebdrive-web@sha256:...
# NGINX_IMAGE=registry.example/mywebdrive-nginx@sha256:...
